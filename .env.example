# Copy to .env and fill in. Never commit .env.

# --- LLM (chat + extraction) ---------------------------------------------------
# HF Inference Providers is the primary; OpenRouter is the RUNTIME FAILOVER —
# when HF throttles or runs out of credits, the same request retries on it.
# NOTE: .env must be a FILE at the repo root, not a folder.
HF_TOKEN=                # HF Inference Providers -> deepseek-ai/DeepSeek-V4.1-Flash-1017
# OR_API_KEY=            # OpenRouter failover -> deepseek/deepseek-v4.1-flash-1017
# CHAT_MODEL=            # override the provider's default model
# EXTRACTION_MODEL=
# LLM_BASE_URL=          # explicit OpenAI-compatible endpoint override
# Daily chat-turn cap for the public demo (plan §11); private instances are uncapped.
# DEMO_DAILY_TURN_CAP=100

# --- Database (private instance) ------------------------------------------------
# Any managed Postgres works (plain SQL, standard features): Neon, Supabase,
# Railway... Migrations run automatically when the backend starts.
# Examples:
#   Supabase (Project -> Connect -> Session pooler):
#     DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Railway (service -> Variables -> DATABASE_URL):
#     DATABASE_URL=postgresql://postgres:<password>@<host>.rlwy.net:<port>/railway
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Instance mode: private (real Gmail) | demo (synthetic data only, D8).
# Without DATABASE_URL the app runs the demo regardless of this value.
INSTANCE_MODE=private

# --- Gmail sync (private instance) ------------------------------------------------
# 1. scripts/auth_gmail.py creates token.json at the repo root (gitignored).
# 2. On a DEPLOYED backend, paste the token.json contents here instead:
# GMAIL_TOKEN_JSON={"refresh_token": "...", "client_id": "...", ...}

# --- Deployed demo (Hugging Face Space) --------------------------------------------
# The public demo is one HF Space (deploy/hf-space.Dockerfile) whose env lives in
# the Space settings, not in .env: HF_TOKEN + OR_API_KEY (secrets) and
# INSTANCE_MODE=demo (variable). It has NO external database: the entrypoint
# starts a small embedded Postgres inside the container (synthetic data only,
# D8) and exports DATABASE_URL to localhost — no pooler to deregister, restart
# reseeds. If you ever point a Space at a MANAGED Postgres instead, copy the
# SESSION POOLER string from its dashboard: Supabase's direct db.<ref>.supabase.co
# host is IPv6-only (Spaces have IPv4 egress only), and newer Supabase projects
# live on aws-1-<region>.pooler.supabase.com, older on aws-0-<region> (wrong pool
# = "tenant/user not found").
