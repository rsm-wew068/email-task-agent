# Copy to .env and fill in. Never commit .env.

# --- LLM (chat + extraction) ---------------------------------------------------
# The first key present selects the provider. NOTE: .env must be a FILE at the
# repo root, not a folder.
OR_API_KEY=              # OpenRouter -> deepseek/deepseek-v4.1-flash-1017
# GEMINI_API_KEY=        # Google AI Studio -> gemini-3.8-flash
# ZAI_API_KEY=           # Z.ai -> glm-5.3-flash
# CHAT_MODEL=            # override the provider's default model
# EXTRACTION_MODEL=
# LLM_BASE_URL=          # explicit OpenAI-compatible endpoint override
# Daily chat-turn cap for the public demo (plan §11); private instances are uncapped.
# DEMO_DAILY_TURN_CAP=100

# --- Database (private instance) ------------------------------------------------
# Any managed Postgres works (plain SQL, standard features): Neon, Supabase,
# Railway... Migrations run automatically when the backend starts.
# Examples:
#   Supabase (Project -> Connect -> Session pooler):
#     DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Railway (service -> Variables -> DATABASE_URL):
#     DATABASE_URL=postgresql://postgres:<password>@<host>.rlwy.net:<port>/railway
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Instance mode: private (real Gmail) | demo (synthetic data only, D8).
# Without DATABASE_URL the app runs the demo regardless of this value.
INSTANCE_MODE=private

# --- Gmail sync (private instance) ------------------------------------------------
# 1. scripts/auth_gmail.py creates token.json at the repo root (gitignored).
# 2. On a DEPLOYED backend, paste the token.json contents here instead:
# GMAIL_TOKEN_JSON={"refresh_token": "...", "client_id": "...", ...}

# --- Deployed demo (Hugging Face Space) --------------------------------------------
# The public demo is one HF Space (deploy/hf-space.Dockerfile); its env lives in
# the Space settings, not in .env: OR_API_KEY (secret) + INSTANCE_MODE=demo
# (variable). It has NO DATABASE_URL on purpose: an unauthenticated public app
# must not share a database with the private instance (D8). Without one, the
# in-memory store reseeds on every restart.
