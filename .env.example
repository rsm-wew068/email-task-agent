# Copy to .env and fill in. Never commit .env.

# Neon Postgres (private instance). Tests skip DB work when unset.
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# LLM provider (extraction + agent). Required from M1 on.
OPENAI_API_KEY=

# Optional tracing (plan rev2/3: LangSmith-style tracing is nice-to-have, not gate-relevant)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=email-task-agent

# Public demo instance must never hold real mail (D8): demo data only, write tools stubbed.
INSTANCE_MODE=private   # private | demo
